# Copy to .env and change the values. .env is git-ignored and excluded from Docker images.
# Never put real secrets anywhere else (code, docs, screenshots, logs).

# Local port for the whole app (only this port is published, on 127.0.0.1)
APP_PORT=8087

# Database passwords (the database is not published outside Docker)
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
APP_DB_PASSWORD=change-me-app-db
DEMO_OWNER_PASSWORD=change-me-demo-owner
DEMO_RO_PASSWORD=change-me-demo-ro

# Optional: leave empty to auto-generate and keep them in the app data volume
SECRET_KEY=
ENCRYPTION_KEY=

# Optional first-run owner (local admin). Read only by the one-shot `migrate` service, and only when no owner
# exists yet; it never changes an existing account. Leave empty to use the first-run setup screen instead.
# Password: at least 12 characters. Change it later in Settings → Security.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_DISPLAY_NAME=Owner
OWNER_TIMEZONE=Asia/Jerusalem

# Read-only demo account for the isolated /demo instance (synthetic data only; safe to share)
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=demo-read-only

# Development/E2E only: a fixed first-run setup token. Leave empty in real use.
INITIAL_SETUP_TOKEN=

# Set to true only when served over HTTPS (server deployment)
COOKIE_SECURE=false

# Optional local components
EMBEDDINGS_ENABLED=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
MODEL_NAME=qwen3:4b
MODEL_STEP_TIMEOUT_SECONDS=300

# Optional external integrations — leave empty unless you configure them yourself
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
IBKR_HOST=
IBKR_PAPER_PORT=4002

# Live trading stays disabled in this build regardless of configuration.
BACKUP_RETENTION_DAYS=30
LOG_LEVEL=INFO
