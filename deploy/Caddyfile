# Local baseline: one port, served by the `web` container (published on 127.0.0.1 only).
{
	admin off
	auto_https off
}

:8080 {
	encode gzip

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# Isolated read-only demo API (separate database, read-only role).
	handle_path /demo/api/* {
		rewrite * /api{path}
		reverse_proxy api-demo:8000 {
			flush_interval -1
		}
	}

	handle /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle /health/* {
		reverse_proxy api:8000
	}

	# /metrics is not exposed through the proxy (internal/ops use only).
	handle /metrics {
		respond 404
	}

	handle {
		root * /srv/app
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	# While the API is still starting (first run: migrations + seed), show a readiness page.
	handle_errors 502 503 504 {
		root * /srv
		rewrite * /starting.html
		file_server
	}
}
